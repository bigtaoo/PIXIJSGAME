{
  "name": "sumquest",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "start": "webpack serve --mode development --open --port 8888",
    "build:web": "webpack --mode production --env TARGET=web",
    "build:wechat": "rollup -c && node -e \"const fs=require('fs'),path=require('path');const src='src/assets',dst='wechatgame/assets';if(fs.existsSync(dst))fs.rmSync(dst,{recursive:true,force:true});fs.mkdirSync(dst,{recursive:true});fs.readdirSync(src).filter(f=>!f.endsWith('.webp')).forEach(f=>fs.copyFileSync(path.join(src,f),path.join(dst,f)));console.log('assets copied')\"",
    "build:crazygames": "webpack --mode production --env TARGET=crazygames",
    "build:telegram": "webpack --mode production --env TARGET=telegram",
    "build:gamedistribution": "webpack --mode production --env TARGET=gamedistribution",
    "format": "prettier --write .",
    "build:mobile": "webpack --mode production --env TARGET=mobile",
    "deploy:ios": "npm run build:mobile && cap sync ios",
    "deploy:android": "npm run build:mobile && cap sync android",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.18.6",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.0.0",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "canvas": "^3.2.3",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "file-loader": "^6.2.0",
    "globals": "^17.6.0",
    "html-webpack-plugin": "^5.6.6",
    "prettier": "^3.8.4",
    "puppeteer": "^25.1.0",
    "rollup": "^4.60.1",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-polyfill-node": "^0.13.0",
    "string-replace-loader": "^3.3.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "webpack": "^5.105.4",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "^5.2.3"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@pixi/unsafe-eval": "^7.4.3",
    "pixi.js-legacy": "^7.4.3"
  }
}
